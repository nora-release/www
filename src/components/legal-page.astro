---
import "../styles/global.css";
import { siteCopy as t } from "../lib/copy";
import type { RichTextSegment } from "../lib/copy";
import PageHead from "./page-head.astro";
import { SiteHeader } from "./site-header";
import SiteFooter from "./site-footer.astro";

type LegalPageKey = "privacy" | "support" | "terms";

interface Props {
  page: LegalPageKey;
}

const { page } = Astro.props;
const content = t.legal[page];
const meta = t.meta[page];
const path = `/${page}`;
---

<!doctype html>
<html lang="en">
  <head>
    <PageHead path={path} title={meta.title} description={meta.description} />
  </head>
  <body class="n-page">
    <a class="skip-link" href="#main">{t.common.skipToContent}</a>
    <SiteHeader
      copy={t.header}
      currentPath={path}
      client:load
    />

    <main id="main" class="legal-page">
      <article class="legal-document">
        <p class="eyebrow">{content.eyebrow}</p>
        <h1>{content.title}</h1>
        <p class="legal-updated">{content.updated}</p>

        {content.sections.map((section) => (
          <section>
            <h2>{section.title}</h2>
            {section.paragraphs.map((paragraph, paragraphIndex) => (
              <p class:list={{ "mt-4": paragraphIndex > 0 }}>
                {paragraph.map((segment) =>
                  typeof segment === "string" ? (
                    segment
                  ) : (
                    <a href={segment.href}>{segment.text}</a>
                  )
                )}
              </p>
            ))}

          </section>
        ))}
      </article>
    </main>

    <SiteFooter copy={t.footer} />
  </body>
</html>

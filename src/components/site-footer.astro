---
import type { FooterCopy } from "../lib/copy";
import { appStoreUrl } from "../lib/site";

interface Props {
  copy: FooterCopy;
}

const { copy } = Astro.props;
const home = "/";
const groups = [
  {
    title: copy.groups.product,
    links: [
      { label: copy.productLinks.download, href: "/#download" },
      { label: copy.productLinks.docs, href: "/docs/" },
      { label: copy.productLinks.faq, href: "/#faq" },
    ],
  },
  {
    title: copy.groups.resources,
    links: [
      { label: copy.resourceLinks.changelog, href: "/changelog" },
      { label: copy.resourceLinks.feedback, href: "/feedback" },
      { label: copy.resourceLinks.support, href: "/support" },
    ],
  },
  {
    title: copy.groups.legal,
    links: [
      { label: copy.legalLinks.privacy, href: "/privacy" },
      { label: copy.legalLinks.terms, href: "/terms" },
    ],
  },
];
---

<footer class="border-t border-dashed border-[var(--rule)] bg-[var(--paper)]">
  <div class="n-wrap grid gap-12 py-14 md:grid-cols-[1.4fr_repeat(3,1fr)]">
    <div>
      <a href={home} class="flex items-center gap-2.5">
        <img src="/icon-192.png" alt="" class="h-8 w-8" />
        <span class="font-semibold">nora<span class="text-[var(--muted-foreground)]">.app</span></span>
      </a>
      <p class="mt-4 max-w-xs text-[0.82rem] leading-relaxed text-[var(--muted-foreground)]">{copy.description}</p>
      <a href={appStoreUrl} class="n-btn n-btn--ink mt-6 !h-9 !text-[0.8rem]">↓ {copy.appStoreButton}</a>
      <p class="n-mono mt-3 text-xs text-[var(--muted-foreground)]">{copy.ctaText}</p>
    </div>
    {
      groups.map((group) => (
        <nav aria-label={group.title}>
          <p class="text-xs text-[var(--muted-foreground)]"><span class="text-[var(--accent-ink)]">/</span> {group.title}</p>
          <ul class="mt-4 space-y-2.5 text-[0.82rem]">
            {group.links.map((link) => (
              <li>
                <a href={link.href} class="n-link">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="n-rule">
    <div class="n-wrap n-mono flex flex-wrap items-center justify-between gap-3 py-5 text-xs text-[var(--muted-foreground)]">
      <span>© {new Date().getFullYear()} Nora. {copy.copyright}</span>
      <span>made for macOS · $ nora --version</span>
    </div>
  </div>
</footer>

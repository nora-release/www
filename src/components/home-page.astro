---
import "../styles/global.css";
import { siteCopy as t } from "../lib/copy";
import { appStoreUrl, siteUrl } from "../lib/site";
import CardGrid from "./home/card-grid.astro";
import DownloadSection from "./home/download-section.astro";
import Faq from "./home/faq.astro";
import Hero from "./home/hero.astro";
import SectionHead from "./home/section-head.astro";
import TerminalSection from "./home/terminal-section.astro";
import PageHead from "./page-head.astro";
import { SiteHeader } from "./site-header";
import SiteFooter from "./site-footer.astro";

const meta = t.meta.home;
const home = t.home;
const softwareApplicationStructuredData = {
  "@type": "SoftwareApplication",
  "@id": `${siteUrl}/#software`,
  name: "Nora",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS 14.0+",
  url: siteUrl,
  downloadUrl: `${siteUrl}${appStoreUrl}`,
  description: meta.description,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  featureList: home.structuredDataFeatureList,
};
const faqStructuredData = {
  "@type": "FAQPage",
  "@id": `${siteUrl}/#faq-schema`,
  mainEntity: home.faq.items.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [softwareApplicationStructuredData, faqStructuredData],
};
---

<!doctype html>
<html lang="en">
  <head>
    <PageHead
      path="/"
      title={meta.title}
      description={meta.description}
      robots="index, follow, max-image-preview:large"
      structuredData={structuredData}
    />
  </head>
  <body class="n-page">
    <SiteHeader
      copy={t.header}
      currentPath="/"
      client:load
    />
    <main>
      <Hero announcement={home.announcement} copy={home.hero} />

      <section id="app" class="scroll-mt-20 py-20 md:py-28">
        <div class="n-wrap">
          <SectionHead copy={home.app} index="01" />
          <div class="mt-12"><CardGrid columns={2} items={home.app.items} /></div>
        </div>
      </section>

      <TerminalSection copy={home.terminal} />

      <section id="extend" class="scroll-mt-20 py-20 md:py-28">
        <div class="n-wrap">
          <SectionHead copy={home.extend} index="03" />
          <div class="mt-12"><CardGrid columns={3} items={home.extend.items} /></div>
        </div>
      </section>

      <Faq copy={home.faq} />
      <DownloadSection copy={home.download} />
    </main>
    <SiteFooter copy={t.footer} />
  </body>
</html>

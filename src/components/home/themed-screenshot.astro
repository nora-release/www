---
/*
 * A product screenshot with a light and a dark version, swapped with the page
 * theme. The files are src/assets/screenshots/<name>-light.png and
 * <name>-dark.png; until both exist, the fallback slot is shown instead.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  alt: string;
  name: string;
}

const { alt, name } = Astro.props;
const screenshots = import.meta.glob<{ default: ImageMetadata }>("../../assets/screenshots/*.png", { eager: true });
const light = screenshots[`../../assets/screenshots/${name}-light.png`]?.default;
const dark = screenshots[`../../assets/screenshots/${name}-dark.png`]?.default;
---

{
  light && dark ? (
    <>
      <Image src={light} alt={alt} widths={[720, 1200, 1800]} sizes="(min-width: 72rem) 68rem, 100vw" class="n-when-light h-auto w-full drop-shadow-[0_24px_40px_rgba(0,0,0,0.28)]" />
      <Image src={dark} alt={alt} widths={[720, 1200, 1800]} sizes="(min-width: 72rem) 68rem, 100vw" class="n-when-dark h-auto w-full drop-shadow-[0_24px_40px_rgba(0,0,0,0.28)]" />
    </>
  ) : (
    <slot />
  )
}

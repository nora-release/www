---
import "../styles/global.css";
import { siteCopy as t } from "../lib/copy";
import { FeedbackDetailView } from "./feedback-detail-view";
import PageHead from "./page-head.astro";
import { SiteHeader } from "./site-header";
import SiteFooter from "./site-footer.astro";

interface Props {
  feedbackId: string;
}

const { feedbackId } = Astro.props;
const meta = t.meta.feedback;
const path = `/feedback/${feedbackId}`;
---

<!doctype html>
<html lang="en">
  <head>
    <PageHead path={path} title={meta.title} description={meta.description} />
  </head>
  <body class="n-page">
    <a class="skip-link" href="#main">{t.common.skipToContent}</a>
    <SiteHeader
      copy={t.header}
      currentPath="/feedback"
      client:load
    />

    <main id="main">
      <FeedbackDetailView
        copy={t.feedback}
        feedbackId={feedbackId}
          client:load
      />
    </main>

    <SiteFooter copy={t.footer} />
  </body>
</html>
